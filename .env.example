# ============================================================
# «Забота» — переменные окружения
# Скопируй в .env.local и заполни свои значения.
# БЕЗ ключей YooKassa приложение работает в dev-режиме оплаты
# (подписка активируется мгновенно, для тестов флоу).
# ============================================================

# --- Авторизация ---
# JWT_SECRET больше не используется: сессии — случайные токены в SQLite.
# Никаких обязательных секретов для auth; секреты нужны только для оплаты ниже.

# --- Оплата (YooKassa, виджет checkout-widget v1) ---
# ID магазина (shopId) из личного кабинета YooKassa
YOOKASSA_SHOP_ID=
# Секретный ключ API (секция «Ключи API» → Ключ для API-запросов)
YOOKASSA_SECRET_KEY=
# Секрет для проверки подписей вебхуков (создаётся в настройках уведомлений)
YOOKASSA_WEBHOOK_SECRET=
# URL вебхука для кабинета YooKassa: https://<домен>/api/payments/webhook

# --- Тарифы ---
# Цена месяца, ₽ (по умолчанию 150)
PRICE_RUB=150
# Цена года, ₽ (по умолчанию 1250)
PRICE_YEAR_RUB=1250
# Цена «навсегда», ₽ (по умолчанию 2700)
PRICE_FOREVER_RUB=2700

# --- Продукт ---
# Публичный базовый URL приложения (для return_url и вебхука)
APP_BASE_URL=http://localhost:3000
# Публичный домен для SEO (canonical, sitemap, OG). Должен быть прод-домен.
NEXT_PUBLIC_APP_URL=https://zabotapsy.ru
# Длительность триала, дней
TRIAL_DAYS=7
# Длительность подписки после оплаты, дней
SUBSCRIPTION_DAYS=30

# --- Данные ---
# Путь к SQLite-файлу с подписками (по умолчанию data/app.db)
DATA_DIR=./data